# PostgreSQL connection string. Required: the server does not start without it.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Optional. Port the API listens on. Defaults to 3000.
PORT=

# Optional. Origin allowed to call the API. Defaults to http://localhost:5173
CORS_ORIGIN=

#Variables to create the admin with seed. 
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""


#JWT SECRET. Needed to create a valid token for login, without login process fail
JWT_SECRET=